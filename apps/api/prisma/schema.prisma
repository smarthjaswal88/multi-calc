generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  DRAFT
  FINALIZED
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  defaultCurrency String @default("USD")

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Document {
  id     String @id @default(cuid())
  userId String

  title    String
  customer String

  issueDate DateTime @db.Date

  status DocumentStatus @default(DRAFT)

  currency String @default("USD")

  subtotalMinor      Int @default(0)
  totalDiscountMinor Int @default(0)
  totalTaxMinor      Int @default(0)
  grandTotalMinor    Int @default(0)

  finalizedAt DateTime?

  archivedAt DateTime?

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines LineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, issueDate])
  @@index([userId, currency])
  @@index([userId, status])
  @@index([userId, archivedAt])
  @@map("documents")
}

model LineItem {
  id         String @id @default(cuid())
  documentId String

  position Int

  description String

  quantity       Int
  unitPriceMinor Int

  discountType DiscountType @default(NONE)

  discountPercentBp Int?

  discountFixedMinor Int?

  taxPercentBp Int?

  lineSubtotalMinor   Int @default(0)
  discountAmountMinor Int @default(0)
  afterDiscountMinor  Int @default(0)
  taxAmountMinor      Int @default(0)
  lineTotalMinor      Int @default(0)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, position])
  @@index([documentId])
  @@map("line_items")
}
